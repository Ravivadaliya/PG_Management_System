@{
	Layout = "~/Views/Shared/LoginLayout.cshtml";
}
@model PG_Management_System.Areas.PG_Owner.Models.Owner
<div class="limiter">
	<div class="container-login100">
		<div class="wrap-login100">
			<div class="login100-pic js-tilt" data-tilt>
				<img src="~/Login/images/img-01.png" alt="IMG">
			</div>

			<form method="post" asp-area="Login" asp-controller="Login" asp-action="LoginAction" class="login100-form validate-form">
				<span class="login100-form-title">
					PG Management
				</span>
				<h6 class="text-danger">@TempData["Error"]</h6>
				
				<div class="wrap-input100 validate-input" data-validate="Password is required" required>
					<input class="input100" type="password" asp-for="Owner_PassWord" placeholder="Enter Old Password">

					<span class="focus-input100"></span>
					<span class="symbol-input100">
						<i class="fa fa-lock" aria-hidden="true"></i>
					</span>
					@* <span asp-validation-for="LoginPerson" class="text-danger"></span> *@

				</div>

				<div class="wrap-input100 validate-input" data-validate="Password is required" required>
					<input class="input100" type="password" asp-for="Owner_PassWord" id="newPassword" placeholder="Enter New Password">

					<span class="focus-input100"></span>
					<span class="symbol-input100">
						<i class="fa fa-lock" aria-hidden="true"></i>
					</span>
					@* <span asp-validation-for="LoginPerson" class="text-danger"></span> *@

				</div>

				<div class="wrap-input100 validate-input" data-validate="Password is required" required>
					<input class="input100" type="password" asp-for="Owner_PassWord" id="reenterPassword" placeholder="Re Enter New Password">

					<span class="focus-input100"></span>
					<span class="symbol-input100">
						<i class="fa fa-lock" aria-hidden="true"></i>
					</span>
					@* <span asp-validation-for="LoginPerson" class="text-danger"></span> *@

				</div>

				<!-- Span to display the password mismatch message -->
				<span id="passwordMessage" class="text-danger"></span>


				<div class="container-login100-form-btn">
					<button class="login100-form-btn" type="submit">
						Login
					</button>
				</div>

				<div class="text-center p-t-12">
					<span class="txt1">
						Forgot
					</span>
					<a class="txt2" href="#">
						Username / Password?
					</a>
				</div>

				<div class="text-center p-t-136">
					@*	<a class="txt2" href="#">
					Create your Account
					<i class="fa fa-long-arrow-right m-l-5" aria-hidden="true"></i>
					</a>*@
				</div>
			</form>
		</div>
	</div>
</div>
<script>
	document.addEventListener("DOMContentLoaded", function () {
		// Get references to the input fields, button, and span
		const newPasswordInput = document.querySelector('#newPassword'); // ID for "New Password"
		const reenterPasswordInput = document.querySelector('#reenterPassword'); // ID for "Re-enter New Password"
		const submitButton = document.querySelector('.login100-form-btn'); // The submit button
		const messageSpan = document.querySelector('#passwordMessage'); // Span to display the message

		// Function to enable/disable the button and show the message
		function toggleButtonState() {
			if (newPasswordInput.value === reenterPasswordInput.value && newPasswordInput.value !== "") {
				submitButton.disabled = false; // Enable the button
				messageSpan.textContent = ""; // Clear the message
			} else {
				submitButton.disabled = true; // Disable the button
				if (newPasswordInput.value !== "" && reenterPasswordInput.value !== "") {
					messageSpan.textContent = "Passwords do not match."; // Show the message
				} else {
					messageSpan.textContent = ""; // Clear the message if fields are empty
				}
			}
		}

		// Attach event listeners to both password fields
		newPasswordInput.addEventListener('input', toggleButtonState);
		reenterPasswordInput.addEventListener('input', toggleButtonState);

		// Initially disable the button and clear the message
		submitButton.disabled = true;
		messageSpan.textContent = "";
	});
</script>



@section Scripts {

	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}