@{
    Layout = "~/Views/Shared/Admin/AdminLayout.cshtml";
}

@using System.Data;

<div class="container">
    <div class="page-inner">
        <div class="page-header">
            <h3 class="fw-bold mb-3">Persons</h3>
            <ul class="breadcrumbs mb-3">
                <li class="nav-home">
                    <a href="#">
                        <i class="icon-home"></i>
                    </a>
                </li>
                <li class="separator">
                    <i class="icon-arrow-right"></i>
                </li>
                <li class="nav-item">
                    <a href="#">Person</a>
                </li>
                <li class="separator">
                    <i class="icon-arrow-right"></i>
                </li>
                <li class="nav-item">
                    <a href="#">See All Person</a>
                </li>
            </ul>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <!-- Search Bar -->

                    <div class="card-header">
                        <div class="d-flex align-items-left align-items-md-center flex-column flex-md-row pt-2 pb-4">
                            <h4 class="card-title">Person View and Delete</h4>
                            <div class="ms-md-auto py-2 py-md-0">
                                <form method="get" asp-action="AllPersonList">
                                    <div class="input-group">
                                        <input type="text" name="searchTerm" class="form-control" placeholder="Search by Name or Bed Number" value="@ViewBag.SearchTerm" />
                                        <button class="btn btn-primary" type="submit">
                                            <i class="fas fa-search"></i> Search
                                        </button>
                                    </div>
                                </form>
                            </div>
                            <div class="ms-md-auto py-2 py-md-0">
                                <a asp-area="PG_Person" asp-controller="PG_Person" asp-action="Add" class="btn btn-primary btn-round me-2">Add Person</a>
                            </div>

                            <a onclick="downloadExcel()" class="btn btn-label-success btn-round  no-print">
                                <span class="btn-label">
                                    <i class="fa fa-print"></i>
                                </span>
                                DownLoad Excel
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="display table table-striped table-hover">
                                <thead>
                                    <tr class="table-striped">
                                        <th>Name</th>
                                        <th>SurName</th>
                                        <th>Bed Number</th>
                                        <th>Sharing</th>
                                        <th>PG Number</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (DataRow dr in Model.Rows)
                                    {
                                        var bedId = dr.Table.Columns.Contains("Bed_Id") && dr["Bed_Id"] != DBNull.Value
                                        ? Convert.ToInt32(dr["Bed_Id"])
                                        : (int?)null;

                                        <tr>
                                            <td>@dr["Person_Name"]</td>
                                            <td>@dr["Person_SurName"]</td>
                                            <td>@(dr["Bed_Number"] != DBNull.Value && dr["Bed_Number"] != null ? dr["Bed_Number"] : "Not Assigned")</td>
                                            <td>@(dr["Room_SharingType"] != DBNull.Value && dr["Room_SharingType"] != null ? dr["Room_SharingType"] : "Not Assigned")</td>
                                            <td>@(dr["PG_Number"] != DBNull.Value && dr["PG_Number"] != null ? dr["PG_Number"] : "Not Assigned")</td>

                                            <td>
                                                <div class="form-button-action">
                                                    <a asp-area="PG_Person" class="btn btn-link btn-primary btn-lg"
                                                       asp-controller="PG_Person"
                                                       asp-action="PersonDetails"
                                                       asp-route-Person_Id="@Convert.ToInt32(dr["Id"])">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-area="PG_Person" class="btn btn-link btn-primary btn-lg" asp-controller="PG_Person" asp-action="Add" asp-route-Person_Id="@Convert.ToInt32(dr["Id"])">
                                                        <i class="fa fa-edit"></i>
                                                    </a>
                                                    @if (!bedId.HasValue)
                                                    {
                                                        <form id="deleteForm-@dr["Id"]" method="post"
                                                              asp-area="PG_Person"
                                                              asp-controller="PG_Person"
                                                              asp-action="personDelete"
                                                              asp-route-Person_Id="@Convert.ToInt32(dr["Id"])">
                                                            <input type="hidden" name="Id" value="@Convert.ToInt32(dr["Id"])" />
                                                            <button type="button" onclick="confirmDelete('@dr["Id"]')"
                                                                    class="btn btn-link btn-danger mt-2">
                                                                <i class="fa fa-times"></i>
                                                            </button>
                                                        </form>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                        <!-- Pagination -->
                        <div class="pagination-container mt-4">
                            <nav aria-label="Pagination">
                                <ul class="pagination justify-content-center">
                                    <li class="">
                                        <h5>@ViewBag.TotalRecords Total Records</h5>
                                    </li>
                                </ul>
                                <ul class="pagination justify-content-center">
                                    <li class="">
                                        @if (ViewBag.CurrentPage == 1)
                                        {
                                            <h5>Showing @(ViewBag.CurrentPage) to @(ViewBag.CurrentPage + 19) records</h5>
                                        }
                                        else
                                        {
                                            <h5>Showing @((ViewBag.CurrentPage * 10) + 1) to @((ViewBag.CurrentPage * 10) + 20) records</h5>
                                        }
                                    </li>
                                </ul>
                                <ul class="pagination justify-content-center">
                                    <!-- Previous Button -->
                                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("AllPersonList", new { pageNumber = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize })" aria-label="Previous">
                                            <span>&laquo;</span>
                                        </a>
                                    </li>

                                    <!-- First Page -->
                                    @if (ViewBag.CurrentPage > 2)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("AllPersonList", new { pageNumber = 1, pageSize = ViewBag.PageSize })">1</a>
                                        </li>
                                        @if (ViewBag.CurrentPage > 3)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }
                                    }

                                    <!-- Page Numbers -->
                                    @for (int i = Math.Max(1, ViewBag.CurrentPage - 1); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 1); i++)
                                    {
                                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("AllPersonList", new { pageNumber = i, pageSize = ViewBag.PageSize })">@i</a>
                                        </li>
                                    }

                                    <!-- Last Page -->
                                    @if (ViewBag.CurrentPage < ViewBag.TotalPages - 1)
                                    {
                                        @if (ViewBag.CurrentPage < ViewBag.TotalPages - 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link" href="@Url.Action("AllPersonList", new { pageNumber = ViewBag.TotalPages, pageSize = ViewBag.PageSize })">@ViewBag.TotalPages</a>
                                        </li>
                                    }

                                    <!-- Next Button -->
                                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="@Url.Action("AllPersonList", new { pageNumber = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize })" aria-label="Next">
                                            <span>&raquo;</span>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>

                        <!-- Pagination ends here -->
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


<script>
    function confirmDelete(OwnerId) {
        Swal.fire({
            title: 'Are you sure?',
            text: `You won't be able to revert this!`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'No, cancel!',
            reverseButtons: true
        }).then((result) => {
            if (result.isConfirmed) {
                // Submit the form for the specific adminId
                document.getElementById(`deleteForm-${OwnerId}`).submit();
            }
        });
    }

    $(document).ready(function () {
        var message = '@TempData["Message"]';
        var alertType = '@TempData["AlertType"]';

        if (message) {
            Swal.fire({
                icon: alertType,
                title: message,
                showConfirmButton: true
            }).then((result) => {
                // Reload the page after the alert is confirmed
                if (result.isConfirmed) {
                    location.reload();
                }
            });
        }
    });

</script>

<script>
    function downloadExcel() {
        // Redirect to the controller action to download the file directly
        window.location.href = '@Url.Action("DownloadPersonData", "PG_Person", new { Area = "PG_Person" })';
    }
</script>